font=JetBrains Mono Nerd Font 11

background-color=#16242d
text-color=#d6e2ee
border-color=#8bc9eb
progress-color=#8bc9eb

width=360
height=120
margin=20
padding=12
border-size=2
border-radius=12

anchor=top-right
layer=overlay

default-timeout=6000
ignore-timeout=1
max-visible=4
icons=1
max-icon-size=48

[urgency=low]
border-color=#5e95bc
text-color=#5e95bc

[urgency=normal]
border-color=#8bc9eb
text-color=#d6e2ee

[urgency=high]
border-color=#4d86b0
text-color=#4d86b0
default-timeout=0
